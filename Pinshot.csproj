<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Pinshot</RootNamespace>
        <AssemblyName>Pinshot</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <Version>0.3.0</Version>
        <Product>Pinshot</Product>
        <Description>Setuna 式截图贴图工具，附文字提取与翻译</Description>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Resources\app.ico" />
        <Resource Include="Resources\icon_128.png" />
        <Resource Include="Resources\icon_256.png" />
    </ItemGroup>

    <ItemGroup>
        <!--  PaddleOCR 模型与 native 依赖内嵌进 exe（启动时释放到本地）  -->
        <EmbeddedResource Include="Resources\Models\**\*" />
        <EmbeddedResource Include="Resources\Native\*.dll" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
        <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
        <PackageReference Include="PaddleOCRSharp" Version="4.1.0" />
        <PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
    </ItemGroup>

</Project>
