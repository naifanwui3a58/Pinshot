<Window
    x:Class="Pinshot.Views.AnnotationToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="图片标注"
    SizeToContent="WidthAndHeight"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Window.Resources>
        <!--  白色主题工具按钮（与整体 UI 统一）  -->
        <Style x:Key="LightToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PART_Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Bd" Property="Background" Value="{StaticResource ControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BorderSoftBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="6,3">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="12"
                Opacity="0.18"
                RenderingBias="Performance"
                ShadowDepth="2" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="PART_BtnPen" Style="{StaticResource LightToolButton}" ToolTip="画笔">
                <Path
                    Width="16"
                    Height="16"
                    Data="M 2,14 L 3,10.5 L 11.5,2 A 1.4,1.4 0 0 1 13.5,2 L 14,2.5 A 1.4,1.4 0 0 1 14,4.5 L 5.5,13 Z M 10.6,2.9 L 13.1,5.4"
                    Fill="#1D2129"
                    Stretch="Uniform" />
            </Button>
            <Button x:Name="PART_BtnMosaic" Style="{StaticResource LightToolButton}" ToolTip="马赛克">
                <Path
                    Width="16"
                    Height="16"
                    Data="M 1,1 H 4 V 4 H 1 Z M 6,1 H 9 V 4 H 6 Z M 11,1 H 14 V 4 H 11 Z M 1,6 H 4 V 9 H 1 Z M 6,6 H 9 V 9 H 6 Z M 11,6 H 14 V 9 H 11 Z M 1,11 H 4 V 14 H 1 Z M 6,11 H 9 V 14 H 6 Z M 11,11 H 14 V 14 H 11 Z"
                    Fill="#1D2129"
                    Stretch="Uniform" />
            </Button>
            <Button x:Name="PART_BtnText" Style="{StaticResource LightToolButton}" ToolTip="文字">
                <Path
                    Width="16"
                    Height="16"
                    Data="M 2,3 H 14 M 8,3 V 13 M 5.5,13 H 10.5"
                    Stroke="#1D2129"
                    StrokeThickness="1.6"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Stretch="Uniform" />
            </Button>
            <Rectangle Width="1" Height="18" Margin="7,0" Fill="{StaticResource BorderSoftBrush}" />
            <Button x:Name="PART_BtnSizeSmall" Content="细" Style="{StaticResource LightToolButton}" ToolTip="细" />
            <Button x:Name="PART_BtnSizeMid" Content="中" Style="{StaticResource LightToolButton}" ToolTip="中" />
            <Button x:Name="PART_BtnSizeLarge" Content="粗" Style="{StaticResource LightToolButton}" ToolTip="粗" />
            <Rectangle Width="1" Height="18" Margin="7,0" Fill="{StaticResource BorderSoftBrush}" />
            <StackPanel x:Name="PART_ColorPanel" Orientation="Horizontal" VerticalAlignment="Center" />
            <Rectangle Width="1" Height="18" Margin="7,0" Fill="{StaticResource BorderSoftBrush}" />
            <Button x:Name="PART_BtnUndo" Style="{StaticResource LightToolButton}" ToolTip="撤回 (Ctrl+Z)">
                <Path
                    Width="16"
                    Height="16"
                    Data="M 6,3 L 2,7 L 6,11 M 2,7 H 10 A 4,4 0 0 1 10,15 H 7"
                    Stroke="#1D2129"
                    StrokeThickness="1.6"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Stretch="Uniform" />
            </Button>
            <Button x:Name="PART_BtnExit" Style="{StaticResource LightToolButton}" ToolTip="退出（放弃修改）">
                <Path
                    Width="14"
                    Height="14"
                    Data="M 2,2 L 12,12 M 12,2 L 2,12"
                    Stroke="#E5484D"
                    StrokeThickness="2"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Stretch="Uniform" />
            </Button>
            <Button x:Name="PART_BtnDone" Style="{StaticResource LightToolButton}" ToolTip="完成 (Enter)">
                <Path
                    Width="14"
                    Height="14"
                    Data="M 2,8 L 6,12 L 13,3"
                    Stroke="#1DA75A"
                    StrokeThickness="2"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Border>
</Window>
