<Window
    x:Class="Pinshot.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Pinshot.Views"
    Title="选项"
    Width="660"
    Height="540"
    Background="{StaticResource WindowBackgroundBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="120" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    x:Name="PART_Nav"
                    Margin="10,14"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource NavItemStyle}"
                    SelectedIndex="0"
                    SelectionChanged="OnNavChanged">
                    <ListBoxItem Content="常规设置" />
                    <ListBoxItem Content="截图设置" />
                    <ListBoxItem Content="截图右键菜单" />
                    <ListBoxItem Content="翻译与提取文字" />
                    <ListBoxItem Content="系统托盘菜单" />
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,18">

                    <!--  常规设置  -->
                    <StackPanel x:Name="PART_SectionGeneral">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="常规设置" />
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <CheckBox x:Name="PART_AutoStart" Content="开机自启动" />
                                <CheckBox
                                    x:Name="PART_RunAsAdmin"
                                    Margin="0,12,0,0"
                                    Content="以管理员身份运行" />
                                <CheckBox
                                    x:Name="PART_PersistPins"
                                    Margin="0,12,0,0"
                                    Content="重启后恢复贴图" />
                                <CheckBox
                                    x:Name="PART_ShowPanel"
                                    Margin="0,12,0,0"
                                    Content="启动时显示主面板" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  截图设置（含原参考图设置）  -->
                    <StackPanel x:Name="PART_SectionCapture" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="截图设置" />
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="截图快捷键" />
                                    <local:HotkeyBox x:Name="PART_HotkeyPin" />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="显隐所有贴图" />
                                    <local:HotkeyBox x:Name="PART_HotkeyToggle" />
                                </DockPanel>
                                <CheckBox
                                    x:Name="PART_CaptureCrosshair"
                                    Margin="0,14,0,0"
                                    Content="显示全屏十字光标" />
                                <CheckBox
                                    x:Name="PART_CaptureMagnifier"
                                    Margin="0,12,0,0"
                                    Content="显示放大镜" />
                                <CheckBox
                                    x:Name="PART_CaptureIncludeCursor"
                                    Margin="0,12,0,0"
                                    Content="截图中保留鼠标指针" />
                                <CheckBox
                                    x:Name="PART_TranslateOverlay"
                                    Margin="0,14,0,0"
                                    Content="图片翻译（译文覆盖在图片原位）" />
                                <CheckBox
                                    x:Name="PART_CompareWindow"
                                    Margin="0,10,0,0"
                                    Content="原文译文对照翻译（弹出对照窗口）" />
                                <CheckBox
                                    x:Name="PART_CompareShowSource"
                                    Margin="24,8,0,0"
                                    Content="显示原文"
                                    IsEnabled="{Binding IsChecked, ElementName=PART_CompareWindow}" />
                                <CheckBox
                                    x:Name="PART_CompareShowTranslation"
                                    Margin="24,8,0,0"
                                    Content="显示译文"
                                    IsEnabled="{Binding IsChecked, ElementName=PART_CompareWindow}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="双击贴图时" />
                                    <ComboBox
                                        x:Name="PART_DoubleClick"
                                        HorizontalAlignment="Left"
                                        MinWidth="180" />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="默认边框" />
                                    <ComboBox
                                        x:Name="PART_DefaultBorder"
                                        HorizontalAlignment="Left"
                                        MinWidth="180" />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="回收站容量" />
                                    <TextBox
                                        x:Name="PART_DustboxCapacity"
                                        Width="64"
                                        HorizontalAlignment="Left"
                                        TextAlignment="Center" />
                                </DockPanel>
                                <CheckBox
                                    x:Name="PART_DragSemiTransparent"
                                    Margin="0,12,0,0"
                                    Content="拖动时保持半透明" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  截图右键菜单  -->
                    <StackPanel x:Name="PART_SectionMenu" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="截图右键菜单" />
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                            <UniformGrid x:Name="PART_MenuItems" Columns="2" />
                        </Border>
                    </StackPanel>

                    <!--  翻译与提取文字  -->
                    <StackPanel x:Name="PART_SectionTranslate" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="翻译与提取文字" />
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="提取文字（OCR）" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="识别语言" />
                                    <ComboBox
                                        x:Name="PART_OcrLanguage"
                                        HorizontalAlignment="Left"
                                        MinWidth="190" />
                                </DockPanel>

                                <CheckBox
                                    x:Name="PART_OcrUpscale"
                                    Margin="0,10,0,0"
                                    Content="小图自动放大识别" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="翻译" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource FieldLabelStyle}" Text="引擎（可多选，按顺序尝试）" />
                                <UniformGrid
                                    x:Name="PART_EngineChecks"
                                    Margin="0,6,0,0"
                                    Columns="2">
                                    <CheckBox x:Name="PART_EngYoudao" Margin="0,0,16,10" Content="有道" />
                                    <CheckBox x:Name="PART_EngMymemory" Margin="0,0,0,10" Content="MyMemory" />
                                    <CheckBox x:Name="PART_EngGoogle" Margin="0,0,16,10" Content="Google" />
                                    <CheckBox x:Name="PART_EngBaidu" Margin="0,0,0,10" Content="百度（需免费 APPID）" />
                                    <CheckBox x:Name="PART_EngCustom" Margin="0,0,16,10" Content="自定义接口" />
                                    <CheckBox x:Name="PART_EngOpenAI" Margin="0,0,0,10" Content="OpenAI 兼容接口" />
                                    <CheckBox x:Name="PART_EngDeepL" Content="DeepL" />
                                </UniformGrid>
                                <DockPanel x:Name="PART_BaiduAppIdRow" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="百度 APPID" />
                                    <TextBox x:Name="PART_BaiduAppId" />
                                </DockPanel>
                                <DockPanel x:Name="PART_CustomUrlRow" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="自定义接口地址" />
                                    <TextBox x:Name="PART_CustomUrl" />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="目标语言" />
                                    <ComboBox x:Name="PART_TargetLang" HorizontalAlignment="Left" MinWidth="180" />
                                </DockPanel>
                                <DockPanel x:Name="PART_BaseUrlRow" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="接口地址" />
                                    <TextBox x:Name="PART_BaseUrl" />
                                </DockPanel>
                                <DockPanel x:Name="PART_ModelRow" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="模型" />
                                    <TextBox x:Name="PART_Model" />
                                </DockPanel>
                                <DockPanel x:Name="PART_ApiKeyRow" Margin="0,12,0,0">
                                    <TextBlock x:Name="PART_ApiKeyLabel" Style="{StaticResource RowLabel}" Text="API Key" />
                                    <TextBox x:Name="PART_ApiKey" />
                                </DockPanel>
                                <CheckBox
                                    x:Name="PART_UseFreeApi"
                                    Margin="0,12,0,0"
                                    Content="使用 DeepL 免费版接口" />

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  系统托盘菜单  -->
                    <StackPanel x:Name="PART_SectionTray" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="系统托盘菜单" />
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                            <ListBox
                                x:Name="PART_TrayItems"
                                Height="360"
                                Background="Transparent"
                                BorderThickness="0" />
                        </Border>
                        <TextBlock
                            Margin="2,8,0,0"
                            Style="{StaticResource HintTextStyle}"
                            Text="勾选 = 在托盘菜单显示；按住条目上下拖动 = 调整托盘菜单顺序。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="16,10"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="84"
                    Click="OnCancel"
                    Content="取消"
                    Style="{StaticResource BaseButtonStyle}" />
                <Button
                    Width="84"
                    Margin="10,0,0,0"
                    Click="OnSave"
                    Content="确定"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
